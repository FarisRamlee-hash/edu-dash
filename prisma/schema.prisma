generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Class {
  id           String        @id @default(cuid())
  name         String
  grade        String
  subject      String        @default("English")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  chapters     Chapter[]
  homework     Homework[]
  notes        Note[]
  weeklyVocabs WeeklyVocab[]
  students     Student[]
  bookSessions BookSession[]
  assessments  Assessment[]
  attendance   Attendance[]
  contacts     ContactLog[]
  textbooks    Textbook[]
}

model Student {
  id             String               @id @default(cuid())
  name           String
  rfidTag        String?
  classId        String
  class          Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  submissions    BookSubmission[]
  attendance     Attendance[]
  marks          Mark[]
  hwSubmissions  HomeworkSubmission[]
  createdAt      DateTime             @default(now())
}

model BookSession {
  id          String           @id @default(cuid())
  label       String           @default("Book Signing")
  classId     String
  class       Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  submissions BookSubmission[]
  createdAt   DateTime         @default(now())
}

model BookSubmission {
  id        String      @id @default(cuid())
  sessionId String
  session   BookSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scannedAt DateTime    @default(now())
}

model Chapter {
  id        String   @id @default(cuid())
  number    Int
  title     String
  status    String   @default("upcoming")
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Homework {
  id          String               @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime
  status      String               @default("pending")
  classId     String
  class       Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  submissions HomeworkSubmission[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model HomeworkSubmission {
  id          String   @id @default(cuid())
  homeworkId  String
  homework    Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submittedAt DateTime @default(now())
  @@unique([homeworkId, studentId])
}

model Note {
  id        String   @id @default(cuid())
  content   String
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  date      DateTime
  status    String   @default("present")
  createdAt DateTime @default(now())
  @@unique([studentId, date])
}

model Assessment {
  id        String   @id @default(cuid())
  title     String
  maxScore  Int      @default(100)
  date      DateTime
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  marks     Mark[]
  createdAt DateTime @default(now())
}

model Mark {
  id           String     @id @default(cuid())
  score        Float
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([assessmentId, studentId])
}

model ContactLog {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   String
  note      String
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model WeeklyVocab {
  id              String    @id @default(cuid())
  weekOf          DateTime
  words           String
  sentences       String
  pdfUrl          String?
  driveFileId     String?
  classroomPostId String?
  uploadedAt      DateTime?
  classId         String?
  class           Class?    @relation(fields: [classId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
}

model Settings {
  id                String  @id @default("singleton")
  googleTokens      String?
  driveFolderId     String?
  classroomCourseId String?
}

model Textbook {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  title     String
  subject   String   @default("")
  filename  String   // stored filename in /public/uploads/textbooks/
  fileSize  Int      @default(0) // bytes
  remarks   String   @default("")
  addedAt   DateTime @default(now())
  createdAt DateTime @default(now())
}
